# ===== 密钥与本地配置（严禁入库）=====
.env
.env.*
!.env.example
*.pem
*.key

# ===== 数据集、模型等大文件（严禁入库）=====
data/
datasets/
# 模型产物：任意 pipeline 的 models/ 下权重不入库；feature_order.txt / manifest.txt 是
# **交付清单（纯文本）**，必须入库才能被审阅/比对（否则干净 clone 缺清单）。
# 故排除任意层级 models/ 的内容，但保留纯文本交付清单。
data_model/pipelines/*/models/**
!data_model/pipelines/*/models/feature_order.txt
!data_model/pipelines/*/models/manifest.txt
artifacts/
*.onnx
*.pkl
*.joblib
*.h5
*.pt
*.pth
*.ckpt
*.safetensors
*.bin

# ===== Python =====
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
*.egg-info/

# ===== 前端 =====
node_modules/
dist/
.vite/

# ===== IDE 与系统 =====
.idea/
.vscode/
.DS_Store
Thumbs.db

# ===== 日志与临时目录 =====
*.log
logs/
_tmp/

# ===== 本地辅助脚本（个人工具，不入库；见 tools/）=====
tools/
