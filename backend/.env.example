# 数据库连接统一用 MySQL（联调 / 演示 / 验收 / 测试同一套，不再区分双库）。
# 复制本文件为 backend/.env，填入本机 MySQL 的账密；
# 建库、建表、灌初始化数据见仓库根目录 infra/setup_mysql.py（一键脚本，非 docker）。
DATABASE_URL=mysql+pymysql://jit:<密码>@127.0.0.1:3306/jit_demo?charset=utf8mb4

# 跑 pytest 时把 DATABASE_URL 指向测试库 jit_test（setup_mysql.py 一并建好）：
#   DATABASE_URL=mysql+pymysql://jit:<密码>@127.0.0.1:3306/jit_test?charset=utf8mb4
API_TOKEN=dev-token-20260918
# 留空即回落 <repo>/data_model/pipelines/expert/models/；禁止写个人绝对路径
MODEL_DIR=
# 「现场预测一个新提交」的开关（#97）：留空 = POST /api/predict 只查库，库里没有的哈希一律 40400。
# 要演这一步就填本地 Apache Camel 克隆的根目录（必须含 .git，且与训练用的同源仓库一致）；
# 后端会现算契约二的 14 维特征再预测。个人机器路径只写进本机 .env（已被 .gitignore），不要写进本模板。
SOURCE_REPO=
# 启动时后台预同步一次最新提交（=1 开启，默认关；需要 SOURCE_REPO 已配置）
SYNC_ON_STARTUP=
