# 复制本文件为 backend/.env（已被 .gitignore 忽略）。
# 数据库统一 MySQL（联调 / 演示 / 验收 / 测试同一套）；建库见仓库根 infra/setup_mysql.py。

# ── 数据库连接：MySQL，分字段填（口令单独一格、原样写，不用转义）───────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=jit
DB_PASSWORD=
# 演示 / 验收 / 联调共用的库（建库脚本会一并建好测试库）
DB_NAME=jit_demo
# pytest 自动切到这个库，不需要手工改本文件
DB_TEST_NAME=jit_test

# 可选：一行 DSN 整段覆盖上面所有字段（CI / 容器场景用；本地留空即可）。
# 填了它就以它为准，DB_HOST 等字段被忽略。
# DATABASE_URL=mysql+pymysql://jit:<密码>@127.0.0.1:3306/jit_demo?charset=utf8mb4

API_TOKEN=dev-token-20260918
# 留空即回落 <repo>/data_model/pipelines/expert/models/；禁止写个人绝对路径
MODEL_DIR=
# 「现场预测一个新提交」的开关（#97）：留空 = POST /api/predict 只查库，库里没有的哈希一律 40400。
# 要演这一步就填本地 Apache Camel 克隆的根目录（必须含 .git，且与训练用的同源仓库一致）；
# 后端会现算契约二的 14 维特征再预测。个人机器路径只写进本机 .env（已被 .gitignore），不要写进本模板。
SOURCE_REPO=
# 启动时后台预同步一次（=1 开启，默认关；需要 SOURCE_REPO 已配置）
SYNC_ON_STARTUP=
# 启动同步分级（change startup-baseline-sync）：
# 首启（prediction 为空）取最新 N 条建基线，避免一次性全量现算 84k 提交
SYNC_INITIAL_LIMIT=10
# 日常增量 / 手动「补齐到最新」追到 HEAD 时的安全上限（缺口超出则截断并提示，防失控）
SYNC_CATCHUP_LIMIT=500
# PR 风险等级阈值（可配）：>= HIGH 为「高」；介于 MID~HIGH 为「中」；否则「低」
# GitHub webhook（change ops-hardening）：配置后 /api/webhook/github 才会受理事件。
# 不配置时该端点一律拒绝（fail closed）。push 事件会触发增量同步。
# WEBHOOK_SECRET=change-me
# WEBHOOK_SYNC_LIMIT=5
# PR 事件触发的一次性 PR 同步条数（每 PR 一次 commit 清单调用；默认只刷新最新 1 个）
# WEBHOOK_PR_LIMIT=1

HIGH_RISK_THRESHOLD=0.5
MID_RISK_THRESHOLD=0.2
