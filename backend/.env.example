DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/jit_defect
API_TOKEN=replace-me-with-a-random-token
# Empty uses <repo>/data_model/pipelines/expert/models/; otherwise use an absolute path.
MODEL_DIR=
# 「现场预测一个新提交」的开关（#97）：留空 = POST /api/predict 只查库，库里没有的哈希一律 40400。
# 要演这一步就填本地 Apache Camel 克隆的根目录（必须含 .git，且与训练用的同源仓库一致）；
# 后端会现算契约二的 14 维特征再预测。个人机器路径只写进本机 .env（已被 .gitignore），
# 不要写进本模板（docs/repo/collaboration.md §0 第 3 条）。
SOURCE_REPO=
