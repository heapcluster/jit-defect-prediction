# 复制本文件为 backend/.env（已被 .gitignore 忽略）。
# 演示与联调使用 MySQL jit_demo；自动测试使用独立的 jit_test。建库见仓库根 infra/setup_mysql.py。

# ── 数据库连接：MySQL，分字段填（口令单独一格、原样写，不用转义）───────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=jit
DB_PASSWORD=
DB_NAME=jit_demo
# pytest 自动切到这个库，不需要手工改本文件
DB_TEST_NAME=jit_test

# 可选：一行 DSN 整段覆盖上面所有字段（CI / 容器场景用；本地留空即可）。
# DATABASE_URL=mysql+pymysql://jit:<密码>@127.0.0.1:3306/jit_demo?charset=utf8mb4

# 本机若有全局 HTTP_PROXY/HTTPS_PROXY，务必把环回地址排除。
NO_PROXY=127.0.0.1,localhost
no_proxy=127.0.0.1,localhost

# ── 平台接口凭证（可选，仅提高接口限额；不进入页面、不写数据库）──────────────
GITHUB_TOKEN=
GITEE_TOKEN=

# ── 模型文件根目录；留空时使用 temp/models ───────────────────────────────────
MODEL_DIR=

# ── 语义线：本地 CodeBERT-base 编码 ───────────────────────────────────────────
# 本地权重目录或模型标识；留空时按默认本地模型路径加载
SEMANTIC_TEXT_MODEL=
# 可选的离线语义向量缓存目录；留空时实时编码
SEMANTIC_EMBEDDINGS=
# 语义编码截断长度，固定 512
SEMANTIC_MAX_LEN=512
