# 演示库 = 每人本机 MySQL jit_demo（Issue #142；联调用 sqlite:///./dev.db）
# 口令写本机 .env，不入库、不进文档
DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/jit_demo?charset=utf8mb4
API_TOKEN=replace-me-with-a-random-token
# Empty uses <repo>/data_model/pipelines/expert/models/; otherwise use an absolute path.
MODEL_DIR=
SOURCE_REPO=
