# 复制本文件为 backend/.env（已被 .gitignore 忽略）。
# 联调、演示与验收使用 MySQL jit_demo；自动测试使用独立的 jit_test。建库见仓库根 infra/setup_mysql.py。

# ── 数据库连接：MySQL，分字段填（口令单独一格、原样写，不用转义）───────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=jit
DB_PASSWORD=
# 演示 / 验收 / 联调共用的库（建库脚本会一并建好测试库）
DB_NAME=jit_demo
# pytest 自动切到这个库，不需要手工改本文件
DB_TEST_NAME=jit_test

# 可选：一行 DSN 整段覆盖上面所有字段（CI / 容器场景用；本地留空即可）。
# 填了它就以它为准，DB_HOST 等字段被忽略。
# DATABASE_URL=mysql+pymysql://jit:<密码>@127.0.0.1:3306/jit_demo?charset=utf8mb4

API_TOKEN=dev-token-20260918
# 本机若有全局 HTTP_PROXY/HTTPS_PROXY，务必把环回地址排除，否则 httpx/requests 连 127.0.0.1:8000
# 也会走代理（表现为「目标计算机积极拒绝」）。不加代理变量时本行无害。
NO_PROXY=127.0.0.1,localhost
no_proxy=127.0.0.1,localhost

# 风险一句话总结：OpenAI 兼容接口（如 https://api.deepseek.com/v1）。
# 三项缺一即回退确定性模板句；Key 只写本机 .env，绝不入库。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=5
# 留空即回落 <repo>/data_model/pipelines/expert/models/；禁止写个人绝对路径
MODEL_DIR=
# 绑定仓库（可选）：留空 = POST /api/predict 只查库，库里没有的哈希一律 40400。
# 填写本地仓库根目录（必须含 .git）后，后端可从该仓库现算 14 维特征再预测。
# 新契约下仓库主要由收集任务/数据集登记时显式指定（docs/database/dataset.md），本变量只是可选默认。
# 个人机器路径只写进本机 .env（已被 .gitignore），不要写进本模板。
SOURCE_REPO=
# 启动时后台预同步一次（=1 开启，默认关；需要 SOURCE_REPO 已配置）
SYNC_ON_STARTUP=
# 同步前是否 git fetch 远端（1 默认；=0 跳过，直接用本地 HEAD，离线/固定版本演示用）
SYNC_FETCH=1
# 启动同步分级（change startup-baseline-sync）：
# 首启（prediction 为空）取最新 N 条建基线，避免一次性全量现算 84k 提交
SYNC_INITIAL_LIMIT=10
# 日常增量 / 手动「补齐到最新」追到 HEAD 时的安全上限（缺口超出则截断并提示，防失控）
SYNC_CATCHUP_LIMIT=500
# 风险等级阈值出厂默认值：>= HIGH 为「高」；介于 MID~HIGH 为「中」；否则「低」。
# 重构后运行期权威 = user_config 表（配置 API / 设置页可改、重启恢复，docs/database/user_config.md）；
# 本模板两值仅在未配置时回退使用。当前版本无 GitHub webhook 或 PR 风险端点；同步入口见 docs/api/sync.md。
HIGH_RISK_THRESHOLD=0.5
MID_RISK_THRESHOLD=0.2
